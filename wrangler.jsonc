{
  // Cloudflare Workers config for the Parahouse site.
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parahouse-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",

  // The site's own domain (registered at Porkbun, DNS on Cloudflare). Each deploy keeps these
  // attached; Cloudflare creates the DNS records and HTTPS certificates itself.
  "routes": [
    { "pattern": "parahouse.co", "custom_domain": true },
    { "pattern": "www.parahouse.co", "custom_domain": true }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only API routes run Worker code; every page and image is served as a static file.
    "run_worker_first": ["/api/*"]
  },

  // Contact form: briefs are sent with Cloudflare Email Service, from the parahouse.co routing
  // domain to the verified Email Routing destination below. Free, no API key. The binding can
  // only send to that address, so the form can never be used to email anyone else.
  "send_email": [
    { "name": "EMAIL", "allowed_destination_addresses": ["parahouse0@gmail.com"] }
  ],
  "vars": {
    "CONTACT_TO": "parahouse0@gmail.com",
    "CONTACT_FROM": "website@parahouse.co",
    // Live visitor count: SHA-256 of the private viewing key (the key itself lives only with Nicholas).
    "LIVE_KEY_HASH": "ef36f9d7d85251e09beb9a91f5940c8f5d53a2e12e12422fb2518ac561236a53"
  },

  // Live visitor count: one Durable Object keeps the open tabs heard from in the last minute, in memory.
  "durable_objects": { "bindings": [{ "name": "PRESENCE", "class_name": "Presence" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Presence"] }],

  "observability": { "enabled": true }
}
